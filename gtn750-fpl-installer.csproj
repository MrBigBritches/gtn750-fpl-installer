<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>gtn750_fpl_installer</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>assets\flight.ico</ApplicationIcon>
    <PlatformTarget>x86</PlatformTarget>
    <Copyright>© $([System.DateTime]::Now.Year) MrBigBritches</Copyright>
    <PublishTrimmed>True</PublishTrimmed>
    <VersionPrefix>1.0.0</VersionPrefix>
  </PropertyGroup>

  <ItemGroup>
    <EditorConfigFiles Remove=".editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="assets\flight.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".github\workflows\create-release.yml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.54.0" />
  </ItemGroup>

</Project>
